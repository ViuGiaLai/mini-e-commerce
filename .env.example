# mock: dùng dữ liệu mẫu và localStorage trên trình duyệt
# production: gọi backend thông qua /api/v1 hoặc NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_API_MODE=mock

# Để trống nếu frontend và backend chạy cùng domain.
NEXT_PUBLIC_API_BASE_URL=

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Chỉ đặt trên server/Render. Tuyệt đối không thêm NEXT_PUBLIC_ vào secret này.
SUPABASE_SECRET_KEY=sb_secret_your_server_key

# Tài khoản admin production và khóa ký cookie phiên đăng nhập.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_SECRET=replace-with-at-least-32-random-characters

# Cloudflare R2 S3 credentials. Chỉ đặt ở server/Render.
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET=viufilm-media
